# ---------- Secrets / environment ----------
# Real .env files never get committed. .env.example is the template and IS tracked.
.env
.env.local
.env.*.local
!*.env.example

# ---------- User-uploaded data (resumes contain personal information) ----------
backend/uploads/
backend/storage/
data/uploads/

