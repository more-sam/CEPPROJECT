__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
htmlcov/
.coverage

# ---------- Node ----------
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
.vite/

