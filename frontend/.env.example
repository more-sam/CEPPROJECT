[TEMPLATE]
# Copy to `.env` to override. Vite only exposes variables prefixed with VITE_.
# Nothing here is secret: every value ends up in the client bundle.

# The API base URL. Must NOT include the /api suffix (the client adds it).
# In production point this at your deployed API, e.g.
#   # Use localhost consistently so cookies work correctly
# (127.0.0.1 and localhost are different origins for browsers)
VITE_API_BASE_URL=https://skillbridge-api.onrender.com
# Use localhost consistently so cookies work correctly
# (127.0.0.1 and localhost are different origins for browsers)
VITE_API_BASE_URL=http://localhost:8000

# Client-side mirror of the backend's MAX_UPLOAD_SIZE_MB, used to reject an
# obviously oversized resume instantly instead of after a long upload. The
# server remains authoritative - if you raise MAX_UPLOAD_SIZE_MB there, raise
# this to match so the browser does not reject files the API would accept.
VITE_MAX_UPLOAD_MB=5
