# =============================================================================
# SkillBridge AI - environment template
# Copy this file to `.env` (same directory) and fill in real values.
#   cp .env.example .env
# NEVER commit the resulting .env file.
# =============================================================================

# ---------- Application ----------
APP_NAME=SkillBridge AI
# development | test | production
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# ---------- Authentication ----------
# Required. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-me-with-a-random-32-byte-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Send the auth cookie only over HTTPS. Keep false for local development.
COOKIE_SECURE=false

# Development-only demo account, created by `python -m app.seed`.
# Set to false to skip. NEVER use these credentials in production.
# The domain must be a real TLD: email validation rejects reserved names such as
# `.local` and `.test`, so a demo@...local address could never sign in.
SEED_DEMO_USER=true
DEMO_USER_EMAIL=demo@skillbridge.dev
DEMO_USER_PASSWORD=DemoPassword123!

# ---------- Database (PostgreSQL) ----------
POSTGRES_USER=skillbridge
POSTGRES_PASSWORD=skillbridge
POSTGRES_DB=skillbridge
# Host port for PostgreSQL. Kept off the default 5432 so a second project on this
# machine can keep its own database running at the same time.
POSTGRES_PORT=5433

# Used when the backend runs on your host machine (outside Docker).
# docker-compose.yml overrides this with the in-network hostname `db`.
DATABASE_URL=postgresql+psycopg://skillbridge:skillbridge@localhost:5433/skillbridge

# ---------- CORS ----------
# Comma-separated list of allowed browser origins.
# Credentials are enabled, so a wildcard "*" is NOT permitted here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Ports exposed on your host ----------
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ---------- File uploads ----------
MAX_UPLOAD_SIZE_MB=5
DATA_DIR=/data
UPLOAD_DIR=/data/uploads

# ---------- AI / NLP ----------
# Semantic (TF-IDF cosine) skill matching. Cheap and local; safe to leave on.
ENABLE_SEMANTIC_MATCHING=true
# Minimum TF-IDF cosine similarity before two concepts are reported as related.
# 0.25 was calibrated against the shipped taxonomy: only the top ~3% of the
# 6,903 skill pairs exceed it, and every pair near the cut-off was manually
# reviewed as genuinely related. Raise for precision, lower for recall.
SEMANTIC_THRESHOLD=0.25

# ---------- Optional LLM provider ----------
# The application is FULLY functional with no key. When absent, the AI Career
# Assistant answers from the student's stored data using deterministic logic.
# Supported values: none | openai | openai-compatible
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Only needed for AI_PROVIDER=openai-compatible (e.g. a local Ollama server).
AI_BASE_URL=
